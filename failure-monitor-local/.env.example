# Airflow REST API base URL (the local airflow-2.7 project by default).
AIRFLOW_API_URL=http://localhost:8081
# Base URL for links to the Airflow UI, as seen from your browser.
AIRFLOW_UI_URL=http://localhost:8081
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
AIRFLOW_VERIFY_SSL=true

# Monitor database: the Postgres cluster start.sh runs from .pgdata/.
DATABASE_URL=postgresql://monitor:monitor@localhost:5433/monitor
RULES_PATH=rules.yaml

POLL_INTERVAL_SECONDS=30
# How far back to look for failures on first start.
INITIAL_LOOKBACK_HOURS=24
